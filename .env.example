# Offline preview works without credentials.
JOBSCORE_MODE=demo
JOBSCORE_ACTOR=local-recruiter
JOBSCORE_ALLOWED_POOLS=current_applicant,past_applicant,employee
JOBSCORE_TOKEN_BUDGET=200000

