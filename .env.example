# Copy to .env and add your key. Use JOBSCORE_MODE=ai and JOBSCORE_SEED=0 for live assessment.
JOBSCORE_MODE=demo
JOBSCORE_SEED=1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=
LLM_REQUESTS_PER_MINUTE=5
LLM_TIMEOUT_SECONDS=180
LLM_QUEUE_TIMEOUT_SECONDS=240
LLM_MAX_OUTPUT_TOKENS=6000
LLM_REASONING_EFFORT=none
JOBSCORE_TOKEN_BUDGET=200000
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# Optional company-approved PEM certificate bundle. TLS verification stays enabled.
# LLM_CA_BUNDLE=C:/certificates/company-approved-ca.pem
